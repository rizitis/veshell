#!/bin/sh

if [ -n "$SHELL" ] &&
   grep -q "$SHELL" /etc/shells &&
   ! (echo "$SHELL" | grep -q "false") &&
   ! (echo "$SHELL" | grep -q "nologin"); then
  if [ "$1" != '-l' ]; then
    exec bash -c "exec -l '$SHELL' -c '$0 -l $*'"
  else
    shift
  fi
fi

# Cursor theme. load_cursor_theme() in src/embedder/cursor.rs falls back to
# a theme literally named "default", which several distributions do not
# ship; without one veshell draws its built-in arrow that never changes
# shape. Only a default -- the environment still wins.
: "${XCURSOR_THEME:=Adwaita}"
: "${XCURSOR_SIZE:=24}"
export XCURSOR_THEME XCURSOR_SIZE

# ---------------------------------------------------------------- logging --
#
# A compositor that dies takes its terminal with it, so anything printed
# to the console is gone before it can be read. Keep a copy on disk.
#
# VESHELL_LOG_DIR chooses where; VESHELL_LOG=no turns it off entirely.
# RUST_LOG is left alone if the caller already set it -- "warn" is quiet
# enough to run with permanently, and get_settings() logs at info on
# every key press, which makes "info" and "debug" unusable for a session
# you actually work in.

: "${VESHELL_LOG:=yes}"
: "${VESHELL_LOG_DIR:=/tmp}"
: "${RUST_LOG:=warn}"
export RUST_LOG

veshell_log_setup() {
    [ "$VESHELL_LOG" = "yes" ] || return 1
    [ -d "$VESHELL_LOG_DIR" ] || return 1

    VESHELL_LOG_FILE="$VESHELL_LOG_DIR/veshell-$(id -un)-$(date +%Y%m%d-%H%M%S).log"

    : > "$VESHELL_LOG_FILE" 2>/dev/null || return 1
    chmod 600 "$VESHELL_LOG_FILE" 2>/dev/null

    # Convenience symlink to the most recent run.
    ln -sf "$VESHELL_LOG_FILE" "$VESHELL_LOG_DIR/veshell-$(id -un)-latest.log" 2>/dev/null

    {
        echo "veshell-session $(date)"
        echo "user:    $(id -un) ($(id -u))"
        echo "tty:     $(tty 2>/dev/null)"
        echo "session: ${XDG_SESSION_ID:-none} vt ${XDG_VTNR:-none} seat ${XDG_SEAT:-none}"
        echo "runtime: ${XDG_RUNTIME_DIR:-unset}"
        echo "cursor:  $XCURSOR_THEME ${XCURSOR_SIZE}"
        echo "RUST_LOG=$RUST_LOG"
        echo "---"
    } >> "$VESHELL_LOG_FILE" 2>/dev/null

    # Keep the last few runs and no more. Logs from a crashing compositor
    # are worth having; a year of them is not.
    ls -1t "$VESHELL_LOG_DIR"/veshell-"$(id -un)"-*.log 2>/dev/null \
        | tail -n +11 | xargs -r rm -f 2>/dev/null

    return 0
}

# Run veshell with output on the console AND in the log file, so a crash
# is readable afterwards even though the terminal went with it. Falls
# back to plain exec if the log file cannot be created -- never refuse to
# start a session over logging.
veshell_run() {
    if ! veshell_log_setup; then
        exec "$@"
    fi

    echo "veshell-session: logging to $VESHELL_LOG_FILE"

    # A pipe loses the exit status of the left-hand side, and PIPESTATUS
    # is a bashism this script cannot rely on, so stash it in a file.
    _st="${VESHELL_LOG_FILE}.status"
    { "$@" 2>&1; echo $? > "$_st"; } | tee -a "$VESHELL_LOG_FILE"
    _rc=$( cat "$_st" 2>/dev/null || echo 0 )
    rm -f "$_st"
    return "${_rc:-0}"
}

# Try to detect the service manager that is being used
if hash systemctl 2>/dev/null; then
    # Make sure there's no already running session.
    if systemctl --user -q is-active veshell.service; then
      echo 'A veshell session is already running.'
      exit 1
    fi

    # Reset failed state of all user units.
    systemctl --user reset-failed

    # Import the login manager environment.
    systemctl --user import-environment

    # DBus activation environment is independent from systemd. While most of
    # dbus-activated services are already using `SystemdService` directive, some
    # still don't and thus we should set the dbus environment with a separate
    # command.
    if hash dbus-update-activation-environment 2>/dev/null; then
        dbus-update-activation-environment --all
    fi

    # Start veshell and wait for it to terminate.
    systemctl --user --wait start veshell.service

    # Force stop of graphical-session.target.
    systemctl --user start --job-mode=replace-irreversibly veshell-shutdown.target

    # Unset environment that we've set.
    systemctl --user unset-environment WAYLAND_DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP
elif hash dinitctl 2>/dev/null; then
    # Check that the user dinit daemon is running
    if ! pgrep -u $(id -u) dinit >/dev/null 2>&1; then
      echo "dinit user daemon is not running."
      exit 1
    fi

    # Make sure there's no already running session.
    if dinitctl --user is-started veshell >/dev/null 2>&1; then
      echo 'A veshell session is already running.'
      exit 1
    fi

    # Start veshell
    dinitctl --user start veshell
else
    # No user service manager: Slackware, Void with runit, Alpine, Gentoo
    # with OpenRC, the BSDs. Upstream used to give up here and tell you to
    # run `veshell --session` by hand, which meant the .desktop entry a
    # display manager reads was useless on those systems.
    #
    # There is nothing a service manager was doing that matters to veshell
    # itself. The units set up a D-Bus session and a couple of environment
    # variables; both are easy without one. veshell exports
    # XDG_CURRENT_DESKTOP, XDG_SESSION_TYPE, GDK_BACKEND and
    # QT_QPA_PLATFORM itself once its Wayland socket is up (see
    # src/embedder/state.rs), so they are deliberately not set here.

    # Refuse to start nested by accident. src/embedder/main.rs picks its
    # backend by looking at DISPLAY and WAYLAND_DISPLAY: with either set it
    # opens a window inside the running session instead of taking over the
    # display, which is rarely what someone launching a session wants.
    if [ -n "$WAYLAND_DISPLAY" ] || [ -n "$DISPLAY" ]; then
        echo "veshell-session: DISPLAY or WAYLAND_DISPLAY is already set."
        echo "veshell-session: veshell would start nested inside the running"
        echo "veshell-session: session. Log out first, or run 'veshell'"
        echo "veshell-session: directly if nesting is what you want."
        exit 1
    fi

    # logind (or elogind) is what hands over the seat and, through libseat,
    # DRM master. Without an active session /dev/dri/* cannot be opened and
    # page flips fail with EACCES.
    if [ -z "$XDG_RUNTIME_DIR" ]; then
        echo "veshell-session: XDG_RUNTIME_DIR is not set."
        echo "veshell-session: no session appears to have been created for"
        echo "veshell-session: this login. Check that pam_elogind (or"
        echo "veshell-session: pam_systemd) is enabled for the login service."
        exit 1
    fi

    # xdg-desktop-portal reads this to pick the backends listed in
    # /usr/share/xdg-desktop-portal/veshell-portals.conf. veshell sets it
    # too, but portals may be activated before that happens.
    export XDG_CURRENT_DESKTOP=veshell

    if hash dbus-run-session 2>/dev/null; then
        veshell_run dbus-run-session -- veshell --session
    else
        echo "veshell-session: dbus-run-session not found; starting without"
        echo "veshell-session: a session bus. Notifications, portals and the"
        echo "veshell-session: network and bluetooth panels will not work."
        veshell_run veshell --session
    fi

    status=$?
    if [ -n "$VESHELL_LOG_FILE" ]; then
        echo "--- veshell exited with status $status at $(date)" \
            >> "$VESHELL_LOG_FILE" 2>/dev/null
        if [ "$status" != "0" ]; then
            echo ""
            echo "veshell-session: veshell exited with status $status."
            echo "veshell-session: log: $VESHELL_LOG_FILE"
            echo ""
            grep -iE "panicked|ERROR" "$VESHELL_LOG_FILE" 2>/dev/null | tail -5
        fi
    fi
    exit $status
fi
