{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Veshell Settings",
    "description": "System settings",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string"
        },
        "keyboard": {
            "type": "object",
            "properties": {
                "layout": {
                    "type": "string"
                },
                "rules": {
                    "type": "string",
                    "description": "XKB rules file. Empty means the default (evdev)."
                },
                "model": {
                    "type": "string",
                    "description": "XKB keyboard model, e.g. pc105. Empty means the default."
                },
                "variant": {
                    "type": "string",
                    "description": "XKB variant, or a comma separated list matching layout."
                },
                "options": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "XKB options, e.g. grp:alt_shift_toggle to switch between layouts."
                },
                "swapAltAndWin": {
                    "type": "boolean"
                },
                "hotkeys": {
                    "type": "object",
                    "properties": {
                        "system": {
                            "type": "object",
                            "properties": {
                                "increaseVolume": {
                                    "type": "string"
                                },
                                "decreaseVolume": {
                                    "type": "string"
                                },
                                "muteVolume": {
                                    "type": "string"
                                }
                            }
                        },
                        "screen": {
                            "type": "object",
                            "properties": {
                                "focusWorkspaceAbove": {
                                    "type": "string"
                                },
                                "focusWorkspaceBelow": {
                                    "type": "string"
                                }
                            }
                        },
                        "workspace": {
                            "type": "object",
                            "properties": {
                                "focusLeftTileable": {
                                    "type": "string"
                                },
                                "focusRightTileable": {
                                    "type": "string"
                                },
                                "closeTileable": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            },
            "additionalProperties": false
        },
        "mouseAndTouchpad": {
            "type": "object",
            "properties": {
                "naturalScrolling": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        "theme": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "string"
                },
                "gtkTheme": {
                    "type": "string"
                },
                "iconTheme": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    }
}
